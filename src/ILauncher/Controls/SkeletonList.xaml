<UserControl x:Class="ILauncher.Controls.SkeletonList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ILauncher.Controls"
             IsHitTestVisible="False"
             Focusable="False">
    <StackPanel Margin="4,6,8,6">
        <!-- Five placeholder rows: icon block, title bar and two meta bars. -->
        <Grid Height="58" Margin="8,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Skeleton Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center" />
            <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:Skeleton Height="11" CornerRadius="5" />
                <controls:Skeleton Grid.Column="1" Height="10" CornerRadius="5" Margin="22,0,0,0" />
                <controls:Skeleton Grid.Row="1" Grid.ColumnSpan="2" Width="210" Height="9" CornerRadius="4"
                                   HorizontalAlignment="Left" Margin="0,9,0,0" />
            </Grid>
        </Grid>
        <Grid Height="58" Margin="8,0,10,0" Opacity="0.92">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Skeleton Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center" />
            <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:Skeleton Height="11" CornerRadius="5" />
                <controls:Skeleton Grid.Column="1" Height="10" CornerRadius="5" Margin="22,0,0,0" />
                <controls:Skeleton Grid.Row="1" Grid.ColumnSpan="2" Width="160" Height="9" CornerRadius="4"
                                   HorizontalAlignment="Left" Margin="0,9,0,0" />
            </Grid>
        </Grid>
        <Grid Height="58" Margin="8,0,10,0" Opacity="0.84">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Skeleton Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center" />
            <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:Skeleton Height="11" CornerRadius="5" />
                <controls:Skeleton Grid.Column="1" Height="10" CornerRadius="5" Margin="22,0,0,0" />
                <controls:Skeleton Grid.Row="1" Grid.ColumnSpan="2" Width="188" Height="9" CornerRadius="4"
                                   HorizontalAlignment="Left" Margin="0,9,0,0" />
            </Grid>
        </Grid>
        <Grid Height="58" Margin="8,0,10,0" Opacity="0.72">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Skeleton Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center" />
            <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.9*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:Skeleton Height="11" CornerRadius="5" />
                <controls:Skeleton Grid.Column="1" Height="10" CornerRadius="5" Margin="22,0,0,0" />
                <controls:Skeleton Grid.Row="1" Grid.ColumnSpan="2" Width="174" Height="9" CornerRadius="4"
                                   HorizontalAlignment="Left" Margin="0,9,0,0" />
            </Grid>
        </Grid>
        <Grid Height="58" Margin="8,0,10,0" Opacity="0.6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Skeleton Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center" />
            <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:Skeleton Height="11" CornerRadius="5" />
                <controls:Skeleton Grid.Column="1" Height="10" CornerRadius="5" Margin="22,0,0,0" />
                <controls:Skeleton Grid.Row="1" Grid.ColumnSpan="2" Width="200" Height="9" CornerRadius="4"
                                   HorizontalAlignment="Left" Margin="0,9,0,0" />
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
