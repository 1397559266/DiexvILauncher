<UserControl x:Class="ILauncher.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ILauncher.Controls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SkinCardButton" TargetType="Button">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="126" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FFFFFFFF" BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1" CornerRadius="11" Padding="8,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB9D5F7" />
                                <Setter TargetName="Bd" Property="Background" Value="#FFFBFDFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="Bd" Property="Background" Value="#FFF7FBFF" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="382" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════ 3D preview ═══════════ -->
        <Border Grid.Column="0" Style="{StaticResource CardShadow}" CornerRadius="16" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:SkinPreview SkinPath="{Binding SkinPath}" SkinModel="{Binding SkinModel}"
                                      CapePath="{Binding CapePath}" AutoRotate="{Binding AutoRotate}" />

                <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,1,0,0" Padding="16,13">
                    <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="当前皮肤" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding SkinName}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoRotate, Mode=TwoWay}" />
                            <TextBlock Text="自动旋转" FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource FilterChip}" Height="30" Content="Steve 经典"
                                          IsChecked="{Binding IsSteve, Mode=OneWay}"
                                          Command="{Binding SetModelCommand}" CommandParameter="Steve" />
                            <ToggleButton Style="{StaticResource FilterChip}" Height="30" Content="Alex 纤细"
                                          IsChecked="{Binding IsAlex, Mode=OneWay}"
                                          Command="{Binding SetModelCommand}" CommandParameter="Alex" />
                        </StackPanel>
                        <TextBlock Text="{Binding ModelText}" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ Right column ═══════════ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="账户与皮肤" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="管理离线账户、本地皮肤库，并可查询正版玩家的皮肤外观。" FontSize="10.5"
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding MicrosoftLoginCommand}"
                                AutomationProperties.Name="正版登录">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Data="{StaticResource IconUser}" Fill="#FF3A5674" Width="13" Height="13" />
                                <TextBlock Text="正版登录" Margin="6,0,0,0" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Height="36" Margin="8,0,0,0"
                                Command="{Binding SignOutMicrosoftCommand}"
                                Visibility="{Binding IsMicrosoftAccount, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="注销微软账号">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Data="{StaticResource IconUser}" Fill="#FF3A5674" Width="13" Height="13" />
                                <TextBlock Text="注销微软账号" Margin="6,0,0,0" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Height="36" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Data="{StaticResource IconFolderOpen}" Fill="#FF3A5674" Width="13" Height="13" />
                                <TextBlock Text="皮肤文件夹" Margin="6,0,0,0" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Height="36" MinWidth="116" Margin="8,0,0,0"
                                Command="{Binding SaveCommand}" AutomationProperties.Name="保存账户与皮肤">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Data="{StaticResource IconSave}" Fill="#FFFFFFFF" Width="13" Height="13" />
                                <TextBlock Text="保存并应用" Margin="6,0,0,0" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Profile -->
                <Border Style="{StaticResource Card}" Padding="18,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <controls:SkinHead SkinPath="{Binding SkinPath}" Width="58" Height="58"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PlayerName}" FontSize="17" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AccountTypeText}" FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding UuidText}" FontFamily="{StaticResource FontMono}" FontSize="8.5"
                                       Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding UuidText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="离线用户名" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBox Style="{StaticResource InputTextBox}" Width="190" Height="34" Margin="0,5,0,0"
                                     Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseAccountSkin, Mode=TwoWay}"
                                          IsEnabled="{Binding HasAccountSkin}"
                                          ToolTip="微软账号登录后，启动器和游戏内都会显示账号自己的皮肤"
                                          AutomationProperties.Name="使用正版账号皮肤" />
                                <TextBlock Text="使用正版账号皮肤" FontSize="9.5" Margin="7,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding SkinSourceText}" FontSize="9"
                                   Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextMuted}" />
                    </Grid>
                </Border>

                <!-- Mojang lookup -->
                <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <controls:Icon Data="{StaticResource IconGlobe}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                            <TextBlock Text="正版皮肤查询" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                            <Border Background="#FFF2F7FD" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="仅外观" FontSize="8.5" Foreground="{StaticResource BrushTextSecondary}" />
                            </Border>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputTextBox}" Height="36" Text="{Binding ProfileLookup, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="36" MinWidth="110" Margin="8,0,0,0"
                                    Command="{Binding LookupCommand}" AutomationProperties.Name="获取皮肤">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{StaticResource IconSearch}" Fill="#FFFFFFFF" Width="13" Height="13" />
                                    <TextBlock Text="获取皮肤" Margin="6,0,0,0" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="2,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:Spinner Width="12" Height="12" Margin="0,2,7,0" VerticalAlignment="Top"
                                              Visibility="{Binding IsLookingUp, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Grid.Column="1" Text="{Binding ProfileStatus}" FontSize="9.5"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap" LineHeight="16" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Skin library -->
                <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Data="{StaticResource IconPuzzle}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                                <TextBlock Text="皮肤库" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                                <Border Background="#FFEAF2FE" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Skins.Count}" FontSize="9" Foreground="{StaticResource BrushAccent}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Height="30" Command="{Binding ImportSkinCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Data="{StaticResource IconPlus}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" />
                                        <TextBlock Text="导入皮肤" Margin="4,0,0,0" FontSize="10.5" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Height="30" Command="{Binding UseDefaultCommand}" Content="默认皮肤" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Skins}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SkinCardButton}"
                                            AutomationProperties.Name="{Binding Name}"
                                            Command="{Binding DataContext.SelectSkinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <controls:SkinHead SkinPath="{Binding Path}" Width="62" Height="62"
                                                               HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       Margin="0,7,0,0" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                                            <TextBlock Text="{Binding SourceText}" FontSize="8.5" Foreground="{StaticResource BrushTextMuted}"
                                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="皮肤文件要求 64×64（或旧版 64×32）；导入后可在左侧切换 Steve / Alex 模型。"
                           FontSize="9" Foreground="{StaticResource BrushTextMuted}" Margin="2,10,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
