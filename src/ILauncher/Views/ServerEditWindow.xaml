<Window x:Class="ILauncher.Views.ServerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务器"
        Width="440" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}"
        FontFamily="{StaticResource FontUi}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding DialogTitle}" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="服务器名称仅用于显示，地址支持 host 或 host:port。" FontSize="10"
                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,5,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="服务器名称" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" />
            <TextBox x:Name="NameBox" Style="{StaticResource InputTextBox}" Height="36" Margin="0,5,0,12"
                     AutomationProperties.Name="服务器名称" />
            <TextBlock Text="服务器地址" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" />
            <TextBox x:Name="AddressBox" Style="{StaticResource InputTextBox}" Height="36" Margin="0,5,0,0"
                     AutomationProperties.Name="服务器地址" />
            <TextBlock Text="例如：mc.example.com 或 mc.example.com:25565" FontSize="9"
                       Foreground="{StaticResource BrushTextMuted}" Margin="2,5,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Height="36" MinWidth="86" Content="取消"
                    IsCancel="True" Click="Cancel_Click" />
            <Button Style="{StaticResource PrimaryButton}" Height="36" MinWidth="86" Margin="8,0,0,0" Content="保存"
                    IsDefault="True" Click="Save_Click" AutomationProperties.Name="保存服务器" />
        </StackPanel>
    </Grid>
</Window>
