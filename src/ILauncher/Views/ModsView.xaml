<UserControl x:Class="ILauncher.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ILauncher.Controls">

    <UserControl.Resources>
        <Style x:Key="ModToggleButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="40" Height="22" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="11" Background="#FFDCE6F3" />
                            <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8" Background="#FFFFFFFF"
                                    HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF173A66" BlurRadius="5" ShadowDepth="1" Opacity="0.22" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrushAccent}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModRowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF5F9FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search -->
        <Border Style="{StaticResource Card}" Height="48" CornerRadius="11">
            <Grid Margin="14,0">
                <controls:Icon Data="{StaticResource IconSearch}" Fill="#FF8FA2B9" Width="16" Height="16"
                               HorizontalAlignment="Left" IsHitTestVisible="False" />
                <TextBox Style="{StaticResource InputTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" Height="44" Padding="30,0,0,0"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="搜索 Mod 名称 / 文件名 / 模组 ID" FontSize="12.5" Foreground="{StaticResource BrushTextMuted}"
                           Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
            </Grid>
        </Border>

        <!-- Actions -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,12" Padding="12,10" CornerRadius="11">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Height="34" Command="{Binding OpenFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconFolderOpen}" Fill="#FF3A5674" Width="14" Height="14" />
                            <TextBlock Text="打开文件夹" Margin="6,0,0,0" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Height="34" Margin="8,0,0,0" Command="{Binding InstallCommand}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconPlus}" Fill="#FF3A5674" Width="14" Height="14" />
                            <TextBlock Text="从文件安装" Margin="6,0,0,0" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Height="34" Margin="8,0,0,0" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconRefresh}" Fill="#FF3A5674" Width="13" Height="13" />
                            <TextBlock Text="刷新" Margin="6,0,0,0" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Height="34" Margin="8,0,0,0" Command="{Binding CheckUpdatesCommand}" AutomationProperties.Name="检查更新">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconDownload}" Fill="#FF3A5674" Width="13" Height="13" />
                            <TextBlock Text="{Binding CheckUpdatesText}" Margin="6,0,0,0" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SummaryText}" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- List -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="16,11,16,7">
                    <ItemsControl ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource FilterChip}" Content="{Binding DisplayTitle}"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding Key}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9.5"
                               Foreground="{StaticResource BrushTextMuted}"
                               Text="启用 / 禁用会在下次启动游戏时生效" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Divider}" Margin="16,0" />

                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <ListBox ItemsSource="{Binding ModsView}" ItemContainerStyle="{StaticResource ModRowItem}"
                             Style="{StaticResource CleanListBox}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="64" Margin="7,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="38" Height="38" CornerRadius="9" Background="#FFF2F8FF" VerticalAlignment="Center">
                                        <Grid>
                                            <controls:Icon Data="{StaticResource IconPuzzle}" Fill="#FFB3CBE8" Width="18" Height="18" />
                                            <Image Source="{Binding IconData, Converter={StaticResource ModIcon}}" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="420" ToolTip="{Binding Name}" />
                                            <Border Background="#FFF1F6FD" CornerRadius="5" Padding="5,1" Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                                             Fill="{Binding Loader, Converter={StaticResource LoaderBrush}}" />
                                                    <TextBlock Text="{Binding Loader}" FontSize="8.5" Margin="4,0,0,0"
                                                               Foreground="{StaticResource BrushTextSecondary}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DetailLine}" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FileName}" FontSize="8.8" Foreground="#FFA7B4C6"
                                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <Button Style="{StaticResource PrimaryButton}" Height="26" MinWidth="52" Margin="0,0,7,0"
                                                Command="{Binding DataContext.UpdateModCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="更新" FontSize="10" />
                                        </Button>
                                        <TextBlock Text="{Binding StateText}" FontSize="9.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Style="{StaticResource ModToggleButton}"
                                                Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Name}"
                                                ToolTip="启用 / 禁用此模组" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Loading -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="正在读取模组信息…" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>

                    <!-- Empty -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="54" Height="54" CornerRadius="16" Background="#FFF2F8FF" HorizontalAlignment="Center">
                            <controls:Icon Data="{StaticResource IconPuzzle}" Fill="#FFA9C6E8" Width="26" Height="26" />
                        </Border>
                        <TextBlock Text="没有找到模组" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="把 Mod 放进 mods 文件夹，或点击上方「从文件安装」。"
                                   FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

