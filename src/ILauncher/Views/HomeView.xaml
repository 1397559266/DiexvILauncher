<UserControl x:Class="ILauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ILauncher.Controls"
             xmlns:views="clr-namespace:ILauncher.Views">

    <UserControl.Resources>
        <Style x:Key="HeroChip" TargetType="Border">
            <Setter Property="Background" Value="#FFF1F6FD" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>

        <Style x:Key="StatBox" TargetType="Border">
            <Setter Property="Background" Value="#FFF7FAFF" />
            <Setter Property="BorderBrush" Value="#FFEAF1FA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="13,8" />
        </Style>

        <Style x:Key="VersionCardItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="98" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Id}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#FFFFFFFF" BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB9D5F7" />
                                <Setter TargetName="Bd" Property="Background" Value="#FFFBFDFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                <Setter TargetName="Bd" Property="Background" Value="#FFF7FBFF" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HomeFilterComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFEAF3FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeFilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="Background" Value="#FFF8FBFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="Padding" Value="9,0,24,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource HomeFilterComboItem}" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource BrushTextMuted}"
                                                  StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,9,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFF1F7FF" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB9D5F7" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" StaysOpen="False">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#FFFFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="4" Margin="0,4,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,22,26,26"
                  PreviewMouseWheel="HomeScroll_PreviewMouseWheel">
            <Grid MaxWidth="1200" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.72*" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- ═══════════ Left column ═══════════ -->
                <StackPanel Grid.Column="0">
                    <!-- Hero -->
                    <Border Style="{StaticResource CardShadow}" CornerRadius="16" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop Color="#FFF8FBFF" Offset="0.55" />
                                    <GradientStop Color="#FFEFF6FF" Offset="1" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Ellipse Grid.RowSpan="2" Width="300" Height="300" Fill="#0D1370F3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-140,-80,0" />
                            <Image Grid.RowSpan="2" Source="{Binding SelectedInstance, Converter={StaticResource InstanceIcon}}" Width="180" Height="180"
                                   Opacity="0.05" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,26,0"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />

                            <Grid Grid.Row="0" Margin="24,22,24,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="104" Height="104" CornerRadius="20" Background="#FFEAF2FE" VerticalAlignment="Top">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF3A76C0" BlurRadius="16" ShadowDepth="3" Opacity="0.16" />
                                    </Border.Effect>
                                    <Image Source="{Binding SelectedInstance, Converter={StaticResource InstanceIcon}}" Width="84" Height="84"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="当前版本" FontSize="10.5" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold" />
                                        <Border Background="#FFE9F9EF" CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                                Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="运行中" FontSize="9.5" Foreground="{StaticResource BrushSuccess}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding SelectedInstance.Id}" Style="{StaticResource TextTitle}" FontSize="27"
                                               Margin="0,3,0,0" MaxWidth="430" HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Border Style="{StaticResource HeroChip}" Background="#FFEAF2FE">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                         Fill="{Binding SelectedInstance.Loader, Converter={StaticResource LoaderBrush}}" />
                                                <TextBlock Text="{Binding SelectedInstance.Loader}" FontSize="10.5" Margin="5,0,0,0"
                                                           Foreground="#FF3D6EA8" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource HeroChip}">
                                            <TextBlock Text="{Binding SelectedInstance.MinecraftVersion}" FontSize="10.5" Foreground="#FF64748B" />
                                        </Border>
                                        <Border Style="{StaticResource HeroChip}">
                                            <TextBlock Text="{Binding SelectedModsText}" FontSize="10.5" Foreground="#FF64748B" />
                                        </Border>
                                        <Border Style="{StaticResource HeroChip}">
                                            <TextBlock Text="{Binding SelectedInstance.TypeLabel}" FontSize="10.5" Foreground="#FF64748B" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Height="42" MinWidth="154"
                                                Command="{Binding LaunchCommand}" AutomationProperties.Name="启动游戏">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Data="{StaticResource IconPlay}" Fill="#FFFFFFFF" Width="15" Height="15" />
                                                <TextBlock Text="启动游戏" Margin="7,0,0,0" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Height="42" MinWidth="126" Margin="10,0,0,0"
                                                Command="{Binding OpenInstanceCommand}" CommandParameter="{Binding SelectedInstance}"
                                                AutomationProperties.Name="版本设置">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Data="{StaticResource IconSettings}" Fill="#FF3A5674" Width="14" Height="14" />
                                                <TextBlock Text="版本设置" Margin="7,0,0,0" FontSize="12.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Height="42" MinWidth="126" Margin="4,0,0,0"
                                                Command="{Binding OpenInstanceModsCommand}" AutomationProperties.Name="模组管理">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Data="{StaticResource IconPuzzle}" Fill="#FF3A5674" Width="14" Height="14" />
                                                <TextBlock Text="模组管理" Margin="7,0,0,0" FontSize="12.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="24,0,24,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StatBox}" Grid.Column="0" Height="52">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:Icon Data="{StaticResource IconJava}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Java" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding SelectedJavaText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource StatBox}" Grid.Column="2" Height="52">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:Icon Data="{StaticResource IconMemory}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="分配内存" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding MemoryText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource StatBox}" Grid.Column="4" Height="52">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:Icon Data="{StaticResource IconFolder}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="游戏目录" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding RootPath}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding RootPath}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Versions header -->
                    <Grid Margin="2,24,4,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="游戏版本" Style="{StaticResource TextSection}" FontSize="16" />
                            <Border Background="#FFEAF2FE" CornerRadius="9" Padding="7,1" Margin="9,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding InstanceCountText}" FontSize="10" Foreground="{StaticResource BrushAccent}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBox Style="{StaticResource HomeFilterCombo}" Width="104" Margin="0,0,6,0"
                                      ItemsSource="{Binding HomeLoaderFilters}"
                                      SelectedItem="{Binding SelectedHomeLoader, Mode=TwoWay}"
                                      ToolTip="按加载器筛选"
                                      AutomationProperties.Name="按加载器筛选" />
                            <ComboBox Style="{StaticResource HomeFilterCombo}" Width="86" Margin="0,0,8,0"
                                      ItemsSource="{Binding HomeTypeFilters}"
                                      SelectedItem="{Binding SelectedHomeType, Mode=TwoWay}"
                                      ToolTip="按版本类型筛选"
                                      AutomationProperties.Name="按版本类型筛选" />
                            <Grid Width="132" Height="26" Margin="0,0,8,0">
                                <TextBox Style="{StaticResource InputTextBox}" Height="26" Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding InstanceSearch, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="搜索版本名称" AutomationProperties.Name="搜索本地版本" />
                                <TextBlock Text="搜索版本" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                           Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding InstanceSearch, Converter={StaticResource EmptyToVisibility}}" />
                            </Grid>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" ToolTip="重新扫描版本">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextSecondary}" Width="13" Height="13" />
                                    <TextBlock Text="刷新" Margin="5,0,0,0" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="没有符合筛选条件的版本" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                               Margin="4,7,0,4"
                               Visibility="{Binding IsHomeFilterEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <ListBox x:Name="VersionList" ItemsSource="{Binding FilteredInstances}" SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                             Style="{StaticResource CleanListBox}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource VersionCardItem}" MouseDoubleClick="VersionList_MouseDoubleClick"
                             HorizontalContentAlignment="Left">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="13,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="9" Background="#FFF3F8FF" VerticalAlignment="Top">
                                        <Image Source="{Binding Path=., Converter={StaticResource InstanceIcon}}" Width="32" Height="32"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushText}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Id}" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                                     Fill="{Binding Loader, Converter={StaticResource LoaderBrush}}" />
                                            <TextBlock Text="{Binding Loader}" FontSize="9" Foreground="{StaticResource BrushTextSecondary}" Margin="4,0,0,0" />
                                            <TextBlock Text="·" FontSize="9" Foreground="{StaticResource BrushTextMuted}" Margin="5,0" />
                                            <TextBlock FontSize="9" Foreground="{StaticResource BrushTextMuted}">
                                                <Run Text="{Binding ModCount}" /><Run Text=" 模组" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <controls:Icon Grid.Column="2" Data="{StaticResource IconChevronRight}" Fill="#FFC5D4E6" Width="13" Height="13"
                                                   VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Quick actions -->
                    <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="16,13">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="快捷操作" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Height="30" Command="{Binding OpenRootFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Data="{StaticResource IconFolderOpen}" Fill="{StaticResource BrushTextSecondary}" Width="13" Height="13" />
                                        <TextBlock Text="打开游戏目录" Margin="5,0,0,0" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Height="30" Margin="6,0,0,0" Command="{Binding GoSettingsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Data="{StaticResource IconSettings}" Fill="{StaticResource BrushTextSecondary}" Width="13" Height="13" />
                                        <TextBlock Text="启动器设置" Margin="5,0,0,0" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ═══════════ Right column ═══════════ -->
                <StackPanel Grid.Column="2">
                    <!-- Account -->
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="14" Background="#FFEFF6FF" ClipToBounds="True">
                                <controls:SkinHead SkinPath="{Binding SkinPath}" Width="52" Height="52" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlayerName}" FontSize="16" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                                    <TextBlock Text="离线账户 · 本地皮肤" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" Margin="5,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="30" Command="{Binding GoAccountCommand}"
                                    Content="管理" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Environment -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="运行环境" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="已就绪" FontSize="10" Foreground="{StaticResource BrushSuccess}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="7" Background="#FFEAF2FE" VerticalAlignment="Center">
                                    <controls:Icon Data="{StaticResource IconJava}" Fill="{StaticResource BrushAccent}" Width="13" Height="13" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Java 运行时" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding SelectedJavaText}" FontSize="11.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="7" Background="#FFEAF2FE" VerticalAlignment="Center">
                                    <controls:Icon Data="{StaticResource IconMemory}" Fill="{StaticResource BrushAccent}" Width="13" Height="13" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="默认内存" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding MemoryText}" FontSize="11.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="7" Background="#FFEAF2FE" VerticalAlignment="Center">
                                    <controls:Icon Data="{StaticResource IconFolder}" Fill="{StaticResource BrushAccent}" Width="13" Height="13" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="游戏目录" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding RootPath}" FontSize="10.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="230" ToolTip="{Binding RootPath}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,14,0,10" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Height="28" Command="{Binding OpenRootFolderCommand}" Content="打开目录" />
                                <Button Style="{StaticResource GhostButton}" Height="28" Command="{Binding GoSettingsCommand}" Content="设置" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Test game promo -->
                    <Border CornerRadius="14" Margin="0,14,0,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0E66E1" Offset="0" />
                                <GradientStop Color="#FF2F8CF3" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Ellipse Width="170" Height="170" Fill="#16FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,-50,0" />
                            <Ellipse Width="110" Height="110" Fill="#10FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,40,-30,0" />
                            <StackPanel Margin="20,18,20,18">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="11" Background="#2BFFFFFF">
                                        <controls:Icon Data="{StaticResource IconFlask}" Stroke="#FFFFFFFF" Fill="Transparent"
                                                       StrokeThickness="1.7" Width="21" Height="21" />
                                    </Border>
                                    <StackPanel Margin="10,1,0,0">
                                        <TextBlock Text="测试游戏" FontSize="15" FontWeight="Bold" Foreground="#FFFFFFFF" />
                                        <TextBlock Text="HMCL 式启动测试" FontSize="9" Foreground="#BFFFFFFF" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="在版本设置的左下角，一键启动并在日志面板中实时查看全部游戏输出。"
                                           Foreground="#E6FFFFFF" FontSize="11.5" TextWrapping="Wrap" Margin="0,13,0,0" LineHeight="19" />
                                <Button Style="{StaticResource GhostButton}" Background="#FFFFFFFF" Foreground="{StaticResource BrushAccent}"
                                        Height="34" Margin="0,14,0,0" HorizontalAlignment="Left" Padding="14,0"
                                        Command="{Binding OpenInstanceCommand}" CommandParameter="{Binding SelectedInstance}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="打开版本设置" FontSize="11.5" FontWeight="SemiBold" />
                                        <controls:Icon Data="{StaticResource IconChevronRight}" Fill="{StaticResource BrushAccent}" Width="12" Height="12" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Empty state -->
        <Border Background="#E6F2F6FC" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardShadow}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="44,36" CornerRadius="16">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="62" Height="62" CornerRadius="18" Background="#FFEAF2FE" HorizontalAlignment="Center">
                        <controls:Icon Data="{StaticResource IconFolderOpen}" Fill="{StaticResource BrushAccent}" Width="28" Height="28" />
                    </Border>
                    <TextBlock Text="还没有找到游戏版本" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="请在设置中选择正确的 .minecraft 目录，ILauncher 会自动扫描其中的全部版本。"
                               FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"
                               TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="打开设置" HorizontalAlignment="Center" Margin="0,18,0,0"
                            Command="{Binding GoSettingsCommand}" MinWidth="130" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>



