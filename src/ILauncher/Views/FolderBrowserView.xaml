<UserControl x:Class="ILauncher.Views.FolderBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ILauncher.Controls">

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="13" Background="#FFEFF6FF" VerticalAlignment="Top">
                    <controls:Icon Data="{Binding IconData}" Fill="{StaticResource BrushAccent}" Width="22" Height="22" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" />
                        <Border Background="#FFEAF2FE" CornerRadius="8" Padding="7,1" Margin="9,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CountText}" FontSize="9.5" Foreground="{StaticResource BrushAccent}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding InstallCommand}" AutomationProperties.Name="导入 ZIP"
                            Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconPlus}" Fill="#FF3A5674" Width="13" Height="13" />
                            <TextBlock Text="导入 ZIP" Margin="6,0,0,0" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Margin="6,0,0,0" Command="{Binding OpenFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconFolderOpen}" Fill="#FF3A5674" Width="13" Height="13" />
                            <TextBlock Text="打开文件夹" Margin="6,0,0,0" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Command="{Binding RefreshCommand}" ToolTip="刷新">
                        <controls:Icon Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextSecondary}" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
            <Grid>
                <ListBox ItemsSource="{Binding Entries}" Style="{StaticResource CleanListBox}" Background="Transparent"
                         Margin="4,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="62" Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="88" Height="50" CornerRadius="8" Background="#FFF2F8FF" ClipToBounds="True"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <controls:Icon Data="{Binding IconData}" Fill="#FFB3CBE8" Width="20" Height="20" />
                                        <Image Source="{Binding ImagePath, Converter={StaticResource PathThumbnail}}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" Height="30"
                                            Command="{Binding DataContext.BackupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding DataContext.CanBackup, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="备份存档" AutomationProperties.Name="备份存档">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:Icon Data="{StaticResource IconSave}" Fill="{StaticResource BrushTextSecondary}"
                                                           Width="11" Height="11" />
                                            <TextBlock Text="备份" FontSize="10.5" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Height="30"
                                            Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="打开" FontSize="10.5" />
                                            <controls:Icon Data="{StaticResource IconExternal}" Fill="{StaticResource BrushTextSecondary}"
                                                           Width="11" Height="11" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="删除" AutomationProperties.Name="删除资源"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <controls:Icon Data="{StaticResource IconTrash}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="56" Height="56" CornerRadius="16" Background="#FFF2F8FF" HorizontalAlignment="Center">
                        <controls:Icon Data="{Binding IconData}" Fill="#FFA9C6E8" Width="26" Height="26" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding EmptyText}" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="0,6,0,0" />
                    <Button Style="{StaticResource SecondaryButton}" Height="34" Margin="0,14,0,0"
                            Command="{Binding OpenFolderCommand}" HorizontalAlignment="Center" Content="打开文件夹" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>



