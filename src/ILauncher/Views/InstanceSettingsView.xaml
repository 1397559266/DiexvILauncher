<UserControl x:Class="ILauncher.Views.InstanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ILauncher.Controls">

    <UserControl.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        </Style>
        <Style x:Key="SettingValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,18,24,22">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="版本设置" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="只对这个版本生效；留空的项目会跟随启动器全局设置。" FontSize="10.5"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Content="恢复全局设置" Command="{Binding ResetCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Height="36" Margin="8,0,0,0" MinWidth="100" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconSave}" Fill="#FFFFFFFF" Width="13" Height="13" />
                            <TextBlock Text="保存设置" Margin="6,0,0,0" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Java -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconJava}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                            <TextBlock Text="Java 运行时" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding JavaRequirement}" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Content="重新检测" Margin="10,0,0,0"
                                    Command="{Binding RefreshJavaCommand}" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="JavaList" ItemsSource="{Binding JavaOptions}" SelectedItem="{Binding SelectedJava, Mode=TwoWay}" PreviewMouseLeftButtonDown="JavaList_PreviewMouseLeftButtonDown"
                             Style="{StaticResource CleanListBox}" MaxHeight="190">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="46" Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <Ellipse Stroke="#FFC6D6E8" StrokeThickness="1.4" Fill="Transparent" />
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrushAccent}"
                                                 Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#FFF2F7FD" CornerRadius="5" Padding="6,2"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsAuto, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="{Binding Major, StringFormat=Java {0}}" FontSize="8.5"
                                                   Foreground="{StaticResource BrushTextSecondary}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding JavaSummary}" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                               Margin="2,7,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Memory & window -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <controls:Icon Data="{StaticResource IconMemory}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                        <TextBlock Text="内存与窗口" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                    </StackPanel>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最大内存" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding MemoryText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccent}" />
                    </Grid>
                    <Slider Style="{StaticResource AccentSlider}" Minimum="1024" Maximum="16384" TickFrequency="512"
                            IsSnapToTickEnabled="True" Value="{Binding MemoryMb, Mode=TwoWay}" />
                    <Grid Margin="0,2,0,0">
                        <TextBlock Text="1 GB" FontSize="8.5" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="16 GB" FontSize="8.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,14,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="自定义游戏窗口大小" FontSize="11" Foreground="{StaticResource BrushText}" />
                            <TextBlock Text="{Binding ResolutionText}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseCustomResolution, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource InputTextBox}" Width="82" Height="32" Padding="8,0" Margin="12,0,0,0"
                                     Text="{Binding Width, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding UseCustomResolution}"
                                     HorizontalContentAlignment="Center" />
                            <TextBlock Text="×" Margin="6,0" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource InputTextBox}" Width="82" Height="32" Padding="8,0"
                                     Text="{Binding Height, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding UseCustomResolution}"
                                     HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Other -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <controls:Icon Data="{StaticResource IconUser}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                        <TextBlock Text="其他信息" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                    </StackPanel>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="玩家名称" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding PlayerName}" Style="{StaticResource SettingValue}" />
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="游戏目录" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding GameDirectory}" Style="{StaticResource SettingValue}"
                                   ToolTip="{Binding GameDirectory}" />
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="版本目录" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding VersionDirectory}" Style="{StaticResource SettingValue}"
                                   ToolTip="{Binding VersionDirectory}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="隔离模式" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding IsolationText}" Style="{StaticResource SettingValue}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Java 与内存设置会在下一次启动时生效。" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                       Margin="2,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

