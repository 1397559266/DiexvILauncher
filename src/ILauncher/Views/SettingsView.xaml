<UserControl x:Class="ILauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ILauncher.Controls">

    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,18,24,0">
            <StackPanel>
                <TextBlock Text="启动器设置" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="扫描目录、Java 运行时、离线账户和默认启动参数。" FontSize="10.5"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource PrimaryButton}" Height="38" MinWidth="110" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Command="{Binding SaveCommand}" AutomationProperties.Name="保存设置">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{StaticResource IconSave}" Fill="#FFFFFFFF" Width="13" Height="13" />
                    <TextBlock Text="保存设置" Margin="6,0,0,0" FontSize="11.5" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16,24,22" HorizontalContentAlignment="Stretch">
            <StackPanel>
                <!-- Language -->
            <Border Style="{StaticResource Card}" Padding="20,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:Icon Data="{StaticResource IconGlobe}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                        <TextBlock Text="语言 / Language" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                    </StackPanel>
                    <ComboBox Style="{StaticResource FilterCombo}" Width="180" Height="30"
                              HorizontalAlignment="Right"
                              ItemsSource="{Binding UiLanguages}"
                              SelectedItem="{Binding SelectedUiLanguage, Mode=TwoWay}"
                              AutomationProperties.Name="语言 / Language">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Game directory -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <controls:Icon Data="{StaticResource IconFolder}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                        <TextBlock Text="游戏目录" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                                 Height="38" FontSize="11.5" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="38" Margin="8,0,0,0"
                                Command="{Binding BrowseRootCommand}" MinWidth="90">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Data="{StaticResource IconFolderOpen}" Fill="#FF3A5674" Width="13" Height="13" />
                                <TextBlock Text="浏览" Margin="6,0,0,0" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="选择包含 versions、libraries、assets 的 .minecraft 目录。保存后会重新扫描全部版本。"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}" Margin="2,7,0,0" />
                </StackPanel>
            </Border>

            <!-- Download source -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <controls:Icon Data="{StaticResource IconDownload}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                        <TextBlock Text="下载源" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="游戏文件下载源" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="镜像源使用 BMCLAPI，适合国内网络；失败时自动回退官方源。"
                                       FontSize="9" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource FilterCombo}" Width="180" Height="34"
                                  ItemsSource="{Binding DownloadSources}"
                                  SelectedItem="{Binding SelectedDownloadSource, Mode=TwoWay}"
                                  AutomationProperties.Name="游戏文件下载源">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Account -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <controls:Icon Data="{StaticResource IconUser}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                        <TextBlock Text="离线账户" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:SkinHead SkinPath="{Binding SkinPath}" Width="44" Height="44"
                                           VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBox Style="{StaticResource InputTextBox}" Height="36" Width="240" HorizontalAlignment="Left"
                                     Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="离线模式仅用于本地启动，不进行正版验证。" FontSize="9"
                                       Foreground="{StaticResource BrushTextMuted}" Margin="2,5,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Java -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconJava}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                            <TextBlock Text="Java 运行时" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource LinkButton}" Content="手动选择"
                                    Command="{Binding BrowseJavaCommand}"
                                    AutomationProperties.Name="手动选择 Java" />
                            <Button Style="{StaticResource LinkButton}" Content="重新检测" Margin="10,0,0,0"
                                    Command="{Binding RefreshJavaCommand}" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="JavaList" ItemsSource="{Binding JavaOptions}" SelectedItem="{Binding SelectedJava, Mode=TwoWay}" PreviewMouseLeftButtonDown="JavaList_PreviewMouseLeftButtonDown"
                             Style="{StaticResource CleanListBox}" MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="44" Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <Ellipse Stroke="#FFC6D6E8" StrokeThickness="1.4" Fill="Transparent" />
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrushAccent}"
                                                 Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Major, StringFormat=Java {0}}" FontSize="8.5"
                                               Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"
                                               Visibility="{Binding IsAuto, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding JavaSummary}" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                               Margin="2,6,0,0" TextTrimming="CharacterEllipsis" />
                    <Border Style="{StaticResource Divider}" Margin="0,11,0,9" />
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="下载 Java（Adoptium Temurin）" FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="自动解压到启动器目录并加入 Java 列表" FontSize="8.5" Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Height="30" MinWidth="54" Content="Java 8"
                                    Command="{Binding DownloadJavaCommand}" CommandParameter="8" />
                            <Button Style="{StaticResource SecondaryButton}" Height="30" MinWidth="54" Margin="6,0,0,0" Content="Java 17"
                                    Command="{Binding DownloadJavaCommand}" CommandParameter="17" />
                            <Button Style="{StaticResource SecondaryButton}" Height="30" MinWidth="54" Margin="6,0,0,0" Content="Java 21"
                                    Command="{Binding DownloadJavaCommand}" CommandParameter="21" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding JavaDownloadText}" FontSize="8.8" Foreground="{StaticResource BrushAccent}"
                               Margin="0,7,0,0" TextWrapping="Wrap"
                               Visibility="{Binding JavaDownloadText, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Defaults -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <controls:Icon Data="{StaticResource IconMemory}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                        <TextBlock Text="默认启动参数" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                    </StackPanel>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="最大内存" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding MemoryText}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider Style="{StaticResource AccentSlider}" Minimum="1024" Maximum="16384" TickFrequency="512"
                            IsSnapToTickEnabled="True" Value="{Binding MemoryMb, Mode=TwoWay}" />

                    <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="游戏窗口大小" Style="{StaticResource Label}" />
                            <TextBlock Text="版本设置中可单独覆盖；跟随启动器尺寸可让游戏窗口随启动器变化"
                                       FontSize="9" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBox Style="{StaticResource FilterCombo}" Width="180" Height="30"
                                      ItemsSource="{Binding WindowModes}"
                                      SelectedItem="{Binding SelectedWindowMode, Mode=TwoWay}"
                                      AutomationProperties.Name="游戏窗口模式">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                                <TextBox Style="{StaticResource InputTextBox}" Width="82" Height="32" Padding="8,0"
                                         Text="{Binding Width, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding IsCustomWindowSize}"
                                         HorizontalContentAlignment="Center" />
                                <TextBlock Text="×" Margin="6,0" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource InputTextBox}" Width="82" Height="32" Padding="8,0"
                                         Text="{Binding Height, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding IsCustomWindowSize}"
                                         HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="启动游戏后最小化启动器" Style="{StaticResource Label}" />
                            <TextBlock Text="适合在游戏启动后把桌面留给游戏窗口" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseLauncher, Mode=TwoWay}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="2,14,0,0">
                <TextBlock Text="{Binding VersionText}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                <TextBlock Text="设置保存于 %APPDATA%\ILauncher\settings.json" FontSize="9"
                           Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>

