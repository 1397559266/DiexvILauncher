<Window x:Class="ILauncher.Views.ModVersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装模组"
        Width="920" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BrushBackground}"
        FontFamily="{StaticResource FontUi}"
        Foreground="{StaticResource BrushText}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Project.DisplayTitle}" FontSize="18" FontWeight="Bold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="选择下载版本、加载器和文件版本" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="下载版本" FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                           VerticalAlignment="Center" Margin="0,0,7,0" />
                <ComboBox Width="145" Height="30"
                          ItemsSource="{Binding GameVersions}"
                          SelectedItem="{Binding SelectedGameVersion, Mode=TwoWay}"
                          AutomationProperties.Name="下载游戏版本" />
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0"
                            Visibility="{Binding ShowLoader, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="加载器" FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center" Margin="0,0,7,0" />
                    <ComboBox Width="105" Height="30"
                              ItemsSource="{Binding Loaders}"
                              SelectedItem="{Binding SelectedLoader, Mode=TwoWay}"
                              AutomationProperties.Name="下载加载器" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                    <TextBlock Text="通道" FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center" Margin="0,0,7,0" />
                    <ComboBox Width="82" Height="30"
                              ItemsSource="{Binding ReleaseFilters}"
                              SelectedItem="{Binding SelectedReleaseFilter, Mode=TwoWay}"
                              AutomationProperties.Name="文件发布通道" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="文件版本" FontSize="11" FontWeight="SemiBold" Margin="12,9,12,7" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                             Style="{StaticResource CleanListBox}" Margin="4,0,4,4"
                             PreviewMouseLeftButtonDown="VersionsList_PreviewMouseLeftButtonDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8" Height="62">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding VersionNumber}" FontSize="12.5" FontWeight="SemiBold" />
                                            <Border Background="#FFF2F7FD" CornerRadius="5" Padding="5,1" Margin="7,0,0,0">
                                                <TextBlock Text="{Binding ReleaseTypeText}" FontSize="8.5"
                                                           Foreground="{StaticResource BrushTextSecondary}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding GameVersionsText}" FontSize="8.5"
                                                   Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding FileName}" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="150" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding DatePublished, StringFormat=yyyy-MM-dd}" FontSize="8.5"
                                                   Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="正在获取兼容文件…" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="12,9,12,6">
                        <TextBlock Text="前置模组" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                   ToolTip="基于 Modrinth 版本声明的必需/可选前置递归检测" />
                        <TextBlock Text="{Binding DependencyStatus}" FontSize="8.5"
                                   Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Dependencies}" Style="{StaticResource CleanListBox}"
                             Margin="4,0,4,4" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="27">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="10"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Background="#FFF2F7FD" CornerRadius="5" Padding="5,1"
                                            Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeText}" FontSize="8.5"
                                                   Foreground="{StaticResource BrushTextSecondary}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="8.5"
                                               Foreground="{StaticResource BrushTextMuted}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasDependencies, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="没有前置模组" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="10,6,10,10">
                        <TextBlock Text="{Binding DependencyStatus}" FontSize="8.5" Foreground="{StaticResource BrushTextMuted}"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,6,0,0"
                              Visibility="{Binding HasMissingRequired, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding MissingRequiredCount, StringFormat=缺少 {0} 个必需前置}"
                                       FontSize="9" Foreground="#FFB45309" VerticalAlignment="Center" />
                            <Button Style="{StaticResource SecondaryButton}" Height="28" MinWidth="118"
                                    HorizontalAlignment="Right"
                                    Content="一键安装缺失前置" Click="InstallDependencies_Click"
                                    IsEnabled="{Binding IsInstallingDependencies, Converter={StaticResource InverseBool}}" />
                        </Grid>
                        <TextBlock Margin="0,5,0,0" FontSize="9" Foreground="#FFB45309" TextWrapping="Wrap"
                                   Text="{Binding UnresolvedRequiredCount, StringFormat=有 {0} 个必需前置无法解析，请检查网络后重试或手动安装。}"
                                   Visibility="{Binding HasUnresolvedRequired, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource SecondaryButton}" Height="28" MinWidth="118" Margin="0,7,0,0"
                                HorizontalAlignment="Left" Content="重新检测前置"
                                Click="RetryDependencies_Click"
                                Visibility="{Binding HasJarError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="文件列表按所选下载版本、加载器和发布通道过滤" FontSize="9"
                       Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Height="34" MinWidth="80" Content="取消"
                        IsCancel="True" />
                <Button Style="{StaticResource PrimaryButton}" Height="34" MinWidth="90" Margin="8,0,0,0"
                        Content="安装此版本" Click="Install_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
