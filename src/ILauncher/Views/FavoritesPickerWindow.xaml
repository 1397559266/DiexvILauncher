<Window x:Class="ILauncher.Views.FavoritesPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ILauncher.Controls"
        Title="收藏资源" Width="640" Height="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}"
        FontFamily="{StaticResource FontUi}"
        Foreground="{StaticResource BrushText}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="从收藏中安装" FontSize="19" FontWeight="Bold" />
            <TextBlock Text="{Binding TargetText}" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource InputTextBox}" Height="32" FontSize="10.5"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="搜索收藏" />
            <ComboBox Grid.Column="1" Style="{StaticResource FilterCombo}" Width="130" Height="32" Margin="8,0,0,0"
                      ItemsSource="{Binding KindFilters}"
                      SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                      AutomationProperties.Name="收藏类型筛选" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6,6">
            <ListBox ItemsSource="{Binding Items}" x:Name="ItemList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="50" Margin="6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="7" Background="#FFF2F8FF" VerticalAlignment="Center">
                                <Image Source="{Binding IconUrl, Converter={StaticResource RemoteIcon}}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,9,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="8.5" Foreground="{StaticResource BrushTextMuted}">
                                    <Run Text="{Binding KindLabel, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding SourceLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="28" MinWidth="72"
                                    Content="下载到本版本" FontSize="10" Padding="10,0"
                                    Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding DataContext.CanInstall, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left" />
            <Button Style="{StaticResource PrimaryButton}" Height="32" MinWidth="150" Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    Content="{Binding InstallAllText}"
                    Command="{Binding InstallAllCommand}"
                    IsEnabled="{Binding CanInstall}"
                    AutomationProperties.Name="安装全部模组收藏" />
            <Button Style="{StaticResource SecondaryButton}" Height="32" MinWidth="80" Content="关闭"
                    HorizontalAlignment="Right" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
