<UserControl x:Class="ILauncher.Views.InstanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ILauncher.Controls">

    <UserControl.Resources>
        <Style x:Key="TestGameButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FF2168C4" />
            <Setter Property="Background" Value="#FFF4F9FF" />
            <Setter Property="BorderBrush" Value="#FFD3E4F8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="11,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                <Setter TargetName="Bd" Property="Background" Value="#FFEFF7FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE4F0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTestActive}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="Background" Value="#FF1370F3" />
                    <Setter Property="BorderBrush" Value="#FF1370F3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════ Sidebar ═══════════ -->
        <Border Background="#FFFFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Version identity -->
                <Grid Grid.Row="0" Margin="16,14,14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="9" Background="#FFF2F8FF">
                        <Image Source="{Binding Instance, Converter={StaticResource InstanceIcon}}" Width="29" Height="29"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Instance.Id}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Instance.Id}" />
                        <TextBlock Text="{Binding Instance.Subtitle}" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="0" Style="{StaticResource Divider}" VerticalAlignment="Bottom" Margin="12,0" />

                <!-- Navigation -->
                <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         Style="{StaticResource SideNavList}" Margin="0,8,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Data="{Binding IconData}" Width="17" Height="17"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Independent test game button, pinned bottom-left -->
                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <Border Style="{StaticResource Divider}" Margin="14,6,14,10" />
                    <TextBlock Text="测试工具" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}" Margin="16,0,0,7" />
                    <Button Style="{StaticResource TestGameButton}" Margin="12,0" Command="{Binding TestGameCommand}" AutomationProperties.Name="测试游戏">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="9" Background="#1A1370F3">
                                <controls:Icon Data="{StaticResource IconFlask}" Fill="Transparent"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               StrokeThickness="1.7" Width="18" Height="18" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="测试游戏" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding TestButtonHint}" FontSize="8.8" Opacity="0.72"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                            <controls:Icon Grid.Column="2" Data="{StaticResource IconChevronRight}" Width="12" Height="12"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Opacity="0.75" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <TextBlock Text="启动游戏并在右侧面板查看全部日志" FontSize="8.8" Foreground="{StaticResource BrushTextMuted}"
                               Margin="16,7,10,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Content ═══════════ -->
        <Border Grid.Column="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF7FAFF" Offset="0" />
                    <GradientStop Color="#FFF0F6FE" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <ContentControl Content="{Binding CurrentModule}" />
        </Border>
    </Grid>
</UserControl>


