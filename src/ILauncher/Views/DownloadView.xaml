<UserControl x:Class="ILauncher.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ILauncher.Controls">

    <UserControl.Resources>
        <Style x:Key="DownloadTabButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF7FBFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB9D5F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushAccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VersionRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="5,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF5F9FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,13">
            <StackPanel>
                <TextBlock Text="下载" FontSize="21" FontWeight="Bold" />
                <TextBlock Text="{Binding TabDescription}" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#FFF7FBFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilterSummary}" FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}" />
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Style="{StaticResource DownloadTabButton}" Tag="{Binding IsGameTab}"
                    Command="{Binding SetTabCommand}" CommandParameter="Game" AutomationProperties.Name="游戏版本">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{StaticResource IconDownload}" Width="17" Height="17"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Text="游戏版本" Margin="8,0,0,0" FontSize="12.5" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DownloadTabButton}" Tag="{Binding IsModsTab}"
                    Command="{Binding SetTabCommand}" CommandParameter="Mods" AutomationProperties.Name="模组">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{StaticResource IconPuzzle}" Width="17" Height="17"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Text="模组" Margin="8,0,0,0" FontSize="12.5" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DownloadTabButton}" Tag="{Binding IsResourcePacksTab}"
                    Command="{Binding SetTabCommand}" CommandParameter="ResourcePacks" AutomationProperties.Name="资源包">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{StaticResource IconLayers}" Width="17" Height="17"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Text="资源包" Margin="8,0,0,0" FontSize="12.5" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DownloadTabButton}" Tag="{Binding IsShadersTab}"
                    Command="{Binding SetTabCommand}" CommandParameter="Shaders" AutomationProperties.Name="光影">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{StaticResource IconSparkles}" Width="17" Height="17"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Text="光影" Margin="8,0,0,0" FontSize="12.5" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ═══════════ Game tab ═══════════ -->
        <Grid Grid.Row="2" Visibility="{Binding IsGameTab, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,13,12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Minecraft 版本" FontSize="13.5" FontWeight="SemiBold" />
                            <Border Background="#FFEAF2FE" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GameVersions.Count}" FontSize="9" Foreground="{StaticResource BrushAccent}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Height="30" Margin="0,0,8,0" Command="{Binding ImportModpackCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{StaticResource IconBox}" Fill="#FF3A5674" Width="12" Height="12" />
                                    <TextBlock Text="导入整合包" Margin="5,0,0,0" FontSize="10.5" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding RefreshGameVersionsCommand}"
                                    ToolTip="重新获取官方版本列表">
                                <controls:Icon Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextSecondary}" Width="13" Height="13" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="0" Style="{StaticResource Divider}" VerticalAlignment="Bottom" />

                    <Border Grid.Row="1" Background="#FFFBFDFF" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,0,1" Padding="14,8">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="版本类型" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox Style="{StaticResource FilterCombo}" Width="112"
                                      ItemsSource="{Binding GameTypeFilters}"
                                      SelectedItem="{Binding SelectedGameType, Mode=TwoWay}"
                                      ToolTip="筛选正式版、快照或旧版"
                                      AutomationProperties.Name="版本类型筛选" />
                            <Grid Width="150" Height="27" Margin="8,0,0,0">
                                <TextBox Style="{StaticResource InputTextBox}" Height="27" Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding VersionSearch, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="搜索版本号，例如 1.20.1"
                                         AutomationProperties.Name="搜索游戏版本" />
                                <TextBlock Text="搜索版本号" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"
                                           Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding VersionSearch, Converter={StaticResource EmptyToVisibility}}" />
                            </Grid>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="GameVersionList" ItemsSource="{Binding GameVersions}" Style="{StaticResource CleanListBox}"
                                 ItemContainerStyle="{StaticResource VersionRow}" Margin="0,4,0,0"
                                 SelectedItem="{Binding SelectedRemoteVersion, Mode=TwoWay}"
                                 PreviewMouseLeftButtonDown="GameVersionList_PreviewMouseLeftButtonDown"
                                 AutomationProperties.Name="Minecraft 版本列表">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="54" Margin="11,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="7" Background="#FFF3F8FF" VerticalAlignment="Center">
                                            <Image Source="{Binding Converter={StaticResource BlockIcon}}" Width="22" Height="22"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="SemiBold" />
                                                <Border Background="#FFF2F7FD" CornerRadius="5" Padding="5,1" Margin="7,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeText}" FontSize="8.5"
                                                               Foreground="{StaticResource BrushTextSecondary}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ReleaseTime, StringFormat=yyyy-MM-dd}" FontSize="9"
                                                       Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsLoadingVersions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="正在获取 Mojang 版本列表…" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Install selected version -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="18,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconDownload}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                            <TextBlock Text="安装游戏版本" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,10,0,4">
                            <TextBlock Text="{Binding SelectedVersionTitle}" FontSize="18" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedVersionSubtitle}" FontSize="9"
                                       Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock Text="加载器" FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,5" />
                            <ComboBox Style="{StaticResource FilterCombo}" Height="30"
                                      ItemsSource="{Binding InstallLoaderOptions}"
                                      SelectedItem="{Binding SelectedInstallLoader, Mode=TwoWay}"
                                      AutomationProperties.Name="安装加载器" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="加载器版本" FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding LoaderVersionStatus}" FontSize="8.5"
                                           Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                            </Grid>
                            <ListBox x:Name="LoaderVersionList" ItemsSource="{Binding LoaderVersions}"
                                     SelectedItem="{Binding SelectedLoaderVersion, Mode=TwoWay}"
                                     Height="176" Margin="0,5,0,0"
                                     PreviewMouseLeftButtonDown="LoaderVersionList_PreviewMouseLeftButtonDown"
                                     AutomationProperties.Name="加载器版本列表">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" Margin="8,5" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="正在获取加载器版本…" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding IsLoadingLoaderVersions, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <Button Grid.Row="5" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,12,0,0"
                                Command="{Binding InstallSelectedCommand}" AutomationProperties.Name="安装所选版本">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Data="{StaticResource IconDownload}" Fill="#FFFFFFFF" Width="13" Height="13" />
                                <TextBlock Text="安装" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <controls:Icon Data="{StaticResource IconInfo}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                            <TextBlock Text="下载说明" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="游戏文件来自 Mojang 官方源；模组、资源包和光影由 Modrinth 提供搜索与安装。每项结果另附 MC百科中文名/条目链接和 CurseForge 搜索链接（CurseForge 当前为网页链接，不直接安装）。"
                                   FontSize="9.2" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="16" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Content search tab ═══════════ -->
        <Grid Grid.Row="2" Visibility="{Binding IsContentTab, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Height="38">
                        <TextBox Style="{StaticResource InputTextBox}" Height="38" Padding="32,0,10,0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <controls:Icon Data="{StaticResource IconSearch}" Fill="#FF9AABBF" Width="14" Height="14"
                                       HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="{Binding SearchPlaceholder}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}"
                                   Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource EmptyToVisibility}}" />
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="38" MinWidth="96" Margin="8,0,0,0"
                            Command="{Binding SearchCommand}" AutomationProperties.Name="搜索下载资源">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconSearch}" Fill="#FFFFFFFF" Width="12" Height="12" />
                            <TextBlock Text="搜索" Margin="5,0,0,0" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,10,0,0">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="游戏版本" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Style="{StaticResource FilterCombo}" Width="180"
                                  ItemsSource="{Binding TargetInstances}"
                                  SelectedItem="{Binding SelectedTargetInstance, Mode=TwoWay}"
                                  ToolTip="选择要搜索/安装到的已安装版本"
                                  AutomationProperties.Name="目标游戏版本">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="搜索版本" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Style="{StaticResource FilterCombo}" Width="140"
                                  ItemsSource="{Binding SearchGameVersionFilters}"
                                  SelectedItem="{Binding SelectedSearchGameVersion, Mode=TwoWay}"
                                  ToolTip="按指定 Minecraft 版本筛选，而不是局限于安装目标"
                                  AutomationProperties.Name="搜索游戏版本" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center"
                                Visibility="{Binding IsModsTab, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="加载器" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Style="{StaticResource FilterCombo}" Width="116"
                                  ItemsSource="{Binding LoaderFilters}"
                                  SelectedItem="{Binding SelectedLoader, Mode=TwoWay}"
                                  ToolTip="筛选模组加载器"
                                  AutomationProperties.Name="加载器筛选" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="类型" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Style="{StaticResource FilterCombo}" Width="124"
                                  ItemsSource="{Binding CategoryFilters}"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  ToolTip="按类型/分辨率/风格筛选"
                                  AutomationProperties.Name="内容类型筛选" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,12,16,8">
                        <TextBlock Text="{Binding TabTitle}" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SearchStatus}" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Row="0" Style="{StaticResource Divider}" VerticalAlignment="Bottom" />

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding SearchResults}" Style="{StaticResource CleanListBox}" Margin="0,4,0,0"
                                 PreviewMouseLeftButtonUp="SearchResultsList_PreviewMouseLeftButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="72" Margin="11,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="9" Background="#FFF3F8FF" VerticalAlignment="Center">
                                            <Grid>
                                                <controls:Icon Data="{StaticResource IconBox}" Fill="#FFB3CBE8" Width="18" Height="18" />
                                                <Image Source="{Binding IconUrl, Converter={StaticResource RemoteIcon}}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="430"
                                                           ToolTip="{Binding Title}" />
                                                <Border Background="#FFF2F7FD" CornerRadius="5" Padding="5,1" Margin="7,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DownloadsText}" FontSize="8.5"
                                                               Foreground="{StaticResource BrushTextMuted}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding CategoryText}" FontSize="8.5" Foreground="{StaticResource BrushTextMuted}"
                                                           VerticalAlignment="Center" />
                                                <Button Style="{StaticResource LinkButton}" Content="MC百科" FontSize="8.5"
                                                        Padding="0,1" Margin="9,0,0,0"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding McmodUrl}" ToolTip="在 MC百科查看此模组"
                                                        Visibility="{Binding HasMcmod, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Style="{StaticResource LinkButton}" Content="CurseForge" FontSize="8.5"
                                                        Padding="0,1" Margin="9,0,0,0"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding CurseForgeUrl}" ToolTip="在 CurseForge 搜索此项目" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="正在搜索…" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding ShowSearchEmpty, Converter={StaticResource BoolToVisibility}}">
                            <Border Width="52" Height="52" CornerRadius="15" Background="#FFF2F8FF" HorizontalAlignment="Center">
                                <controls:Icon Data="{StaticResource IconSearch}" Fill="#FFA9C6E8" Width="24" Height="24" />
                            </Border>
                            <TextBlock Text="搜索在线资源" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Text="输入关键词后点击搜索；结果会按筛选条件过滤。"
                                       FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="380" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                            Padding="16,8">
                        <Grid>
                            <TextBlock Text="{Binding SearchPageText}" FontSize="9.5"
                                       Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Height="28" Content="上一页"
                                        Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GhostButton}" Height="28" Content="下一页"
                                        Command="{Binding NextPageCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Progress -->
        <Border Grid.Row="2" Style="{StaticResource CardShadow}" CornerRadius="13" Padding="16,13" Width="520"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding ProgressTitle}" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProgressMessage}" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" Height="28" HorizontalAlignment="Right" Content="取消"
                            Command="{Binding CancelCommand}" />
                </Grid>
                <ProgressBar Grid.Row="1" Style="{StaticResource SlimProgressBar}" Margin="0,10,0,0"
                             Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>






