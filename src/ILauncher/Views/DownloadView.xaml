<UserControl x:Class="ILauncher.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ILauncher.Controls">

    <UserControl.Resources>
        <Style x:Key="DownloadTabButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF7FBFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB9D5F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushAccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VersionRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="5,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF5F9FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,13">
            <StackPanel>
                <TextBlock Text="下载" FontSize="21" FontWeight="Bold" />
                <TextBlock Text="{Binding TabDescription}" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#FFF7FBFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilterSummary}" FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Style="{StaticResource DownloadTabButton}" Tag="{Binding IsGameTab}"
                          Command="{Binding SetTabCommand}" CommandParameter="Game" AutomationProperties.Name="游戏版本">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{StaticResource IconDownload}" Width="14" Height="14"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    <TextBlock Text="游戏版本" Margin="6,0,0,0" FontSize="11.5" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DownloadTabButton}" Tag="{Binding IsModsTab}"
                          Command="{Binding SetTabCommand}" CommandParameter="Mods" AutomationProperties.Name="模组">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{StaticResource IconPuzzle}" Width="14" Height="14"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    <TextBlock Text="模组" Margin="6,0,0,0" FontSize="11.5" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DownloadTabButton}" Tag="{Binding IsResourcePacksTab}"
                          Command="{Binding SetTabCommand}" CommandParameter="ResourcePacks" AutomationProperties.Name="资源包">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{StaticResource IconLayers}" Width="14" Height="14"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    <TextBlock Text="资源包" Margin="6,0,0,0" FontSize="11.5" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DownloadTabButton}" Tag="{Binding IsShadersTab}"
                          Command="{Binding SetTabCommand}" CommandParameter="Shaders" AutomationProperties.Name="光影">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{StaticResource IconSparkles}" Width="14" Height="14"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    <TextBlock Text="光影" Margin="6,0,0,0" FontSize="11.5" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ═══════════ Game tab ═══════════ -->
        <Grid Grid.Row="2" Visibility="{Binding IsGameTab, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,13,12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Minecraft 版本" FontSize="13.5" FontWeight="SemiBold" />
                            <Border Background="#FFEAF2FE" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GameVersions.Count}" FontSize="9" Foreground="{StaticResource BrushAccent}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowSnapshots, Mode=TwoWay}" />
                                <TextBlock Text="显示快照" FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Style="{StaticResource SecondaryButton}" Height="30" Margin="0,0,8,0" Command="{Binding ImportModpackCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{StaticResource IconBox}" Fill="#FF3A5674" Width="12" Height="12" />
                                    <TextBlock Text="导入整合包" Margin="5,0,0,0" FontSize="10.5" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding RefreshGameVersionsCommand}"
                                    ToolTip="重新获取官方版本列表">
                                <controls:Icon Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextSecondary}" Width="13" Height="13" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="0" Style="{StaticResource Divider}" VerticalAlignment="Bottom" />

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding GameVersions}" Style="{StaticResource CleanListBox}"
                                 ItemContainerStyle="{StaticResource VersionRow}" Margin="0,4,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="54" Margin="11,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="7" Background="#FFF3F8FF" VerticalAlignment="Center">
                                            <Image Source="{Binding Id, Converter={StaticResource BlockIcon}}" Width="22" Height="22"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="SemiBold" />
                                                <Border Background="#FFF2F7FD" CornerRadius="5" Padding="5,1" Margin="7,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeText}" FontSize="8.5"
                                                               Foreground="{StaticResource BrushTextSecondary}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ReleaseTime, StringFormat=yyyy-MM-dd}" FontSize="9"
                                                       Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="30" MinWidth="66"
                                                Command="{Binding DataContext.InstallVersionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="安装此版本">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Data="{StaticResource IconDownload}" Fill="#FF3A5674" Width="11" Height="11" />
                                                <TextBlock Text="安装" Margin="5,0,0,0" FontSize="10.5" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsLoadingVersions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="正在获取 Mojang 版本列表…" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Loader installation -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="18,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <controls:Icon Data="{StaticResource IconWrench}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                            <TextBlock Text="安装模组加载器" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentInstanceText}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Fabric / Quilt 会以当前版本为基础创建新实例。" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                   TextWrapping="Wrap" Margin="0,4,0,12" LineHeight="15" />
                        <Button Style="{StaticResource PrimaryButton}" Height="36" Command="{Binding InstallFabricCommand}" AutomationProperties.Name="安装 Fabric">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Loaders/fabric.png" Width="15" Height="15" />
                                <TextBlock Text="安装 Fabric（最新）" Margin="6,0,0,0" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Height="36" Margin="0,8,0,0" Command="{Binding InstallQuiltCommand}" AutomationProperties.Name="安装 Quilt">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Loaders/quilt.png" Width="14" Height="14" />
                                <TextBlock Text="安装 Quilt（最新）" Margin="6,0,0,0" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding InstallForgeCommand}" AutomationProperties.Name="安装 Forge">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/Loaders/forge.png" Width="14" Height="14" />
                                    <TextBlock Text="Forge" Margin="5,0,0,0" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding InstallNeoForgeCommand}" AutomationProperties.Name="安装 NeoForge">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/Loaders/neoforge.png" Width="14" Height="14" />
                                    <TextBlock Text="NeoForge" Margin="5,0,0,0" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="Forge / NeoForge 会调用官方安装器；OptiFine 请使用其官方安装器。"
                                   FontSize="8.8" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,9,0,0" LineHeight="15" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <controls:Icon Data="{StaticResource IconInfo}" Fill="{StaticResource BrushAccent}" Width="15" Height="15" />
                            <TextBlock Text="下载说明" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="游戏文件来自 Mojang 官方源；模组、资源包和光影来自 Modrinth。安装游戏时会同时下载资源文件，体积可能较大。"
                                   FontSize="9.2" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="16" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Content search tab ═══════════ -->
        <Grid Grid.Row="2" Visibility="{Binding IsContentTab, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Height="38">
                        <TextBox Style="{StaticResource InputTextBox}" Height="38" Padding="32,0,10,0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:Icon Data="{StaticResource IconSearch}" Fill="#FF9AABBF" Width="14" Height="14"
                                       HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="{Binding SearchPlaceholder}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}"
                                   Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource EmptyToVisibility}}" />
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="38" MinWidth="96" Margin="8,0,0,0"
                            Command="{Binding SearchCommand}" AutomationProperties.Name="搜索下载资源">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconSearch}" Fill="#FFFFFFFF" Width="12" Height="12" />
                            <TextBlock Text="搜索" Margin="5,0,0,0" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,12,16,8">
                        <TextBlock Text="{Binding TabTitle}" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SearchStatus}" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Row="0" Style="{StaticResource Divider}" VerticalAlignment="Bottom" />

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding SearchResults}" Style="{StaticResource CleanListBox}" Margin="0,4,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="72" Margin="11,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="9" Background="#FFF3F8FF" VerticalAlignment="Center">
                                            <Grid>
                                                <controls:Icon Data="{StaticResource IconBox}" Fill="#FFB3CBE8" Width="18" Height="18" />
                                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="430" />
                                                <Border Background="#FFF2F7FD" CornerRadius="5" Padding="5,1" Margin="7,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DownloadsText}" FontSize="8.5"
                                                               Foreground="{StaticResource BrushTextMuted}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding CategoryText}" FontSize="8.5" Foreground="{StaticResource BrushTextMuted}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="30" MinWidth="70"
                                                Command="{Binding DataContext.InstallProjectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="安装此资源">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Data="{StaticResource IconDownload}" Fill="#FFFFFFFF" Width="11" Height="11" />
                                                <TextBlock Text="安装" Margin="5,0,0,0" FontSize="10.5" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="正在搜索 Modrinth…" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasSearchResults, Converter={StaticResource InverseBoolToVisibility}}">
                            <Border Width="52" Height="52" CornerRadius="15" Background="#FFF2F8FF" HorizontalAlignment="Center">
                                <controls:Icon Data="{StaticResource IconSearch}" Fill="#FFA9C6E8" Width="24" Height="24" />
                            </Border>
                            <TextBlock Text="搜索 Modrinth" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Text="输入关键词后点击搜索；结果会按当前版本的 Minecraft 与加载器过滤。"
                                       FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="380" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Progress -->
        <Border Grid.Row="2" Style="{StaticResource CardShadow}" CornerRadius="13" Padding="16,13" Width="520"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding ProgressTitle}" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProgressMessage}" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" Height="28" HorizontalAlignment="Right" Content="取消"
                            Command="{Binding CancelCommand}" />
                </Grid>
                <ProgressBar Grid.Row="1" Style="{StaticResource SlimProgressBar}" Margin="0,10,0,0"
                             Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>




