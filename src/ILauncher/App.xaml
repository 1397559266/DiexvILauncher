<Application x:Class="ILauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:ILauncher.Core"
             xmlns:vm="clr-namespace:ILauncher.ViewModels"
             xmlns:views="clr-namespace:ILauncher.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Generic.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <core:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <core:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <core:InverseBoolConverter x:Key="InverseBool" />
            <core:NullToVisibilityConverter x:Key="NullToVisibility" />
            <core:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />
            <core:StringEmptyToVisibilityConverter x:Key="EmptyToVisibility" />
            <core:StringEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" Invert="True" />
            <core:BoolToOpacityConverter x:Key="BoolToOpacity" />
            <core:ModIconConverter x:Key="ModIcon" />
            <core:LoaderBrushConverter x:Key="LoaderBrush" />
            <core:LogLevelBrushConverter x:Key="LogLevelBrush" />
            <core:BlockIconConverter x:Key="BlockIcon" />
            <core:InstanceIconConverter x:Key="InstanceIcon" />
            <core:PathToThumbnailConverter x:Key="PathThumbnail" />
            <core:Base64ImageConverter x:Key="Base64Image" />
            <core:RelativeTimeConverter x:Key="RelativeTime" />

            <DataTemplate DataType="{x:Type vm:MainViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstanceViewModel}">
                <views:InstanceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountViewModel}">
                <views:AccountView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DownloadViewModel}">
                <views:DownloadView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
                <views:OverviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModsViewModel}">
                <views:ModsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LaunchLogViewModel}">
                <views:LaunchLogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FolderBrowserViewModel}">
                <views:FolderBrowserView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ServersViewModel}">
                <views:ServersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstanceSettingsViewModel}">
                <views:InstanceSettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
