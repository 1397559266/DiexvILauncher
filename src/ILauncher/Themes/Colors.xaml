<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PCL2 inspired palette -->
    <Color x:Key="ColorAccent">#FF1370F3</Color>
    <Color x:Key="ColorAccentDark">#FF0B5BCB</Color>
    <Color x:Key="ColorAccentLight">#FF4890F5</Color>
    <Color x:Key="ColorAccentSoft">#FFEAF2FE</Color>
    <Color x:Key="ColorAccentSoft2">#FFDCEBFD</Color>
    <Color x:Key="ColorText">#FF2B3648</Color>
    <Color x:Key="ColorTextSecondary">#FF64748B</Color>
    <Color x:Key="ColorTextMuted">#FF94A3B8</Color>
    <Color x:Key="ColorBorder">#FFE5EDF8</Color>
    <Color x:Key="ColorBorderStrong">#FFD6E3F3</Color>
    <Color x:Key="ColorBackground">#FFF2F6FC</Color>
    <Color x:Key="ColorSurface">#FFFFFFFF</Color>
    <Color x:Key="ColorSurfaceAlt">#FFF8FBFF</Color>
    <Color x:Key="ColorHover">#FFF1F6FD</Color>
    <Color x:Key="ColorSuccess">#FF16A34A</Color>
    <Color x:Key="ColorWarning">#FFE8A23D</Color>
    <Color x:Key="ColorDanger">#FFE5484D</Color>
    <Color x:Key="ColorDebug">#FF8A97A8</Color>
    <Color x:Key="ColorLauncher">#FF1370F3</Color>

    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentDark" Color="{StaticResource ColorAccentDark}" />
    <SolidColorBrush x:Key="BrushAccentLight" Color="{StaticResource ColorAccentLight}" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}" />
    <SolidColorBrush x:Key="BrushAccentSoft2" Color="{StaticResource ColorAccentSoft2}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushTextOnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}" />
    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceAlt" Color="{StaticResource ColorSurfaceAlt}" />
    <SolidColorBrush x:Key="BrushHover" Color="{StaticResource ColorHover}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushDebug" Color="{StaticResource ColorDebug}" />
    <SolidColorBrush x:Key="BrushLauncher" Color="{StaticResource ColorLauncher}" />
    <SolidColorBrush x:Key="BrushSuccessSoft" Color="#FFE9F9EF" />
    <SolidColorBrush x:Key="BrushWarningSoft" Color="#FFFDF4E4" />
    <SolidColorBrush x:Key="BrushDangerSoft" Color="#FFFCEBEC" />
    <SolidColorBrush x:Key="BrushLauncherSoft" Color="#FFEAF2FE" />
    <SolidColorBrush x:Key="BrushCodeBackground" Color="#FFFBFDFF" />

    <LinearGradientBrush x:Key="BrushHeader" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0C66E4" Offset="0" />
        <GradientStop Color="#FF1370F3" Offset="0.45" />
        <GradientStop Color="#FF3E93F7" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushHeroTint" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF7FBFF" Offset="0" />
        <GradientStop Color="#FFEAF3FE" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushTestTint" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0F6FE9" Offset="0" />
        <GradientStop Color="#FF2F8BF4" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="FontUi">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <DropShadowEffect x:Key="EffectCardShadow" Color="#FF2B5E9E" BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.09" />
    <DropShadowEffect x:Key="SoftShadow" Color="#FF1F4E8C" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.07" />
    <DropShadowEffect x:Key="ButtonShadow" Color="#FF1370F3" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.27" />

    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TextSection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    </Style>

    <Style x:Key="TextMuted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>

    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
    </Style>

</ResourceDictionary>
